# Controller
# Note: For Docker-first usage, database is persisted in Docker volume.
# This path is used for local CLI tools and testing only.
CONTAINER_ORCH_DB_PATH=/tmp/orchestry/orchestry.db

# Nginx 
CONTAINER_ORCH_NGINX_CONTAINER=orchestry-nginx
CONTAINER_ORCH_NGINX_CONF_DIR=./configs/nginx

# Controller host and port settings
CONTAINER_ORCH_HOST=0.0.0.0
CONTAINER_ORCH_PORT=8000

# Controller Load Balancer Settings (for cluster mode)
CONTROLLER_LB_HOST=localhost
CONTROLLER_LB_PORT=8000

# Individual Controller Ports (for cluster mode)
CONTROLLER_1_PORT=8001
CONTROLLER_2_PORT=8002
CONTROLLER_3_PORT=8003


# Optional
# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# Docker socket path (if different from default)
# DOCKER_SOCKET=/var/run/docker.sock

# Network name for containers
# CONTAINER_ORCH_NETWORK=orchestry

# SSL/TLS Configuration (if using HTTPS)
# CONTAINER_ORCH_SSL_CERT_PATH=/path/to/cert.pem
# CONTAINER_ORCH_SSL_KEY_PATH=/path/to/key.pem

# Metrics configuration
# CONTAINER_ORCH_METRICS_ENABLED=true
# CONTAINER_ORCH_METRICS_PORT=9090

# Health check configuration
# CONTAINER_ORCH_HEALTH_CHECK_INTERVAL=30
# CONTAINER_ORCH_HEALTH_CHECK_TIMEOUT=10

# Scaling configuration defaults
# CONTAINER_ORCH_DEFAULT_MIN_REPLICAS=1
# CONTAINER_ORCH_DEFAULT_MAX_REPLICAS=10
# CONTAINER_ORCH_DEFAULT_TARGET_CPU=70
# CONTAINER_ORCH_DEFAULT_TARGET_MEMORY=80

# Authentication (not yet implemented)
# CONTAINER_ORCH_API_KEY=your-secret-api-key
# CONTAINER_ORCH_AUTH_ENABLED=false
